# --- Switching providers on and off -------------------------------------------
# The day a free tier stops being free, set its flag to 0. That provider leaves the
# pool, every agent silently routes to what is left, and the app keeps working
# exactly as before. No code change, no uninstall, no key to delete.
ENABLE_LOCAL=1
ENABLE_NVIDIA=1
ENABLE_GEMINI=1

# --- NVIDIA NIM (optional) ---------------------------------------------------
# Key from https://build.nvidia.com/settings/api-keys
# Leave this out entirely and the app still works — everything routes to local.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# Requests per minute. Set below the published ceiling: being throttled costs a whole
# retry, waiting a moment costs a moment.
NVIDIA_RPM=36

# --- Google Gemini (optional) -------------------------------------------------
# Key from https://aistudio.google.com/apikey — has a free tier, which is why this
# is enabled alongside NIM rather than disabled like OpenAI and Anthropic below.
# Uses Google's OpenAI-compatible surface, so no adapter is involved.
# GEMINI_API_KEY=AIza...
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Use an alias, not a dated name: Google retires those (gemini-2.0-flash
# already 404s), and an alias keeps pointing at the current model.
GEMINI_MODEL=gemini-flash-latest
# Gemini lists what it will actually serve, so its catalog is trusted rather than
# probed model by model — probing would spend free-tier requests confirming
# something already true. Set to 0 to probe it anyway.
GEMINI_TRUST_CATALOG=1
# Gemini's free tier is the tightest limit in the app, so this is the one that
# actually bites. Lower it if you see 'cooling down' in /api/providers.
GEMINI_RPM=12

# --- Local models (no key) ---------------------------------------------------
# Any OpenAI-compatible server. Ollama is the default; LM Studio serves the same
# shape on http://127.0.0.1:1234/v1.
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# Ollama lists only what is already on disk, so its catalog is trusted rather than
# probed model by model. Set to 0 to probe it anyway.
LOCAL_TRUST_CATALOG=1
# CPU inference is slow and a cold model loads from disk before the first token.
LOCAL_READ_TIMEOUT=300
LOCAL_PROBE_TIMEOUT=180
# Every token costs wall-clock time locally. This cap is what keeps small work
# genuinely faster than the round trip to NIM.
LOCAL_MAX_TOKENS=700
# 0 = ungated. Nothing is metering local requests; the only limit is the CPU, and
# OCTOPUS_LOCAL_PARALLEL already handles that.
LOCAL_RPM=0

# --- Routing -----------------------------------------------------------------
# auto  — weigh each subtask; light work goes local, heavy work to a hosted model
# Any provider name also works as a pin: local, nvidia, gemini
OCTOPUS_ROUTE=auto
# Weight above which a subtask is 'heavy'. Lower it to send more work to a hosted
# provider; which one is decided by `prefers` and `priority` in providers.py.
OCTOPUS_ROUTE_THRESHOLD=0.55
# How much non-Latin script (Devanagari, Arabic, CJK, Bengali) pushes a task toward a
# hosted model. A local 7B writes decent English and thin Hindi, so language is a
# capability signal rather than a size one. 0 disables the bias entirely.
OCTOPUS_NON_LATIN_BIAS=0.30
# Local inference contends for this machine's cores, so it gets its own, much
# narrower parallelism limit than hosted work.
OCTOPUS_LOCAL_PARALLEL=2
OCTOPUS_MAX_PARALLEL=6

# --- Discord control ----------------------------------------------------------
# The easy front door, and the one to reach for. Discord's gateway is an outbound
# WebSocket, so there is no public URL, no tunnel, no webhook signature and no
# inbound port — this process dials out. Works from the Discord phone app.
#
# Setup, once:
#   1. discord.com/developers/applications -> New Application -> Bot
#   2. Reset Token, copy it into DISCORD_TOKEN
#   3. On the Bot page turn ON "MESSAGE CONTENT INTENT" (privileged). Without it
#      the bot connects and sees every message as empty, which looks like being
#      ignored rather than like a missing setting.
#   4. OAuth2 -> URL Generator -> scopes: bot; permissions: Send Messages,
#      Read Message History. Open the generated URL to invite it to your server.
#   5. In Discord: User Settings -> Advanced -> Developer Mode on, then
#      right-click your own name -> Copy User ID -> DISCORD_ALLOWED
ENABLE_DISCORD=0
DISCORD_TOKEN=
# Numeric user IDs, comma separated. Empty means the bot ignores everyone — that is
# deliberately useless rather than deliberately open.
DISCORD_ALLOWED=
# Optional: also restrict to specific channel ids. Empty means any channel it can see.
DISCORD_CHANNELS=
DISCORD_MAX_BODY=1900

# --- WhatsApp by QR scan (UNOFFICIAL — READ THIS) -----------------------------
#  Links the way WhatsApp Web does: scan a QR once, session persists. No Meta
#  account, no tunnel, no 24-hour window.
#
#  It drives the WhatsApp Web protocol through an unofficial client (whatsmeow via
#  neonize). WhatsApp's terms prohibit that, and enforcement is real. A ban lands
#  on the PHONE NUMBER, not on a key — what is at risk is the account itself, its
#  chats, groups and contacts.
#
#  USE A SPARE NUMBER. Not the one that matters.
#
#  Two switches on purpose: one to enable, one to say the paragraph above was read.
ENABLE_WHATSAPP_QR=0
WHATSAPP_QR_ACCEPT_RISK=0
# Numbers allowed to drive it, international format, no '+'. Empty means nobody.
WHATSAPP_QR_ALLOWED=
# Linked-device credentials. Treat as a secret; gitignored. Anyone with this file
# can act as your WhatsApp.
WHATSAPP_QR_SESSION=wa_session.sqlite3
WHATSAPP_QR_MAX_BODY=3500

# --- WhatsApp control ---------------------------------------------------------
# Drive the agent pool from your phone. Meta's official WhatsApp Cloud API, which
# has a free tier; the unofficial WhatsApp Web libraries get accounts banned and
# are not supported here.
#
# Setup, once:
#   1. developers.facebook.com -> create an app -> add the WhatsApp product
#   2. copy the temporary access token and the Phone number ID
#   3. expose this service:  cloudflared tunnel --url http://localhost:8000
#   4. in the WhatsApp product config, set the Callback URL to
#      <that https url>/api/whatsapp and the Verify token to WHATSAPP_VERIFY_TOKEN
#      below, then subscribe to the 'messages' field
#   5. put your own number in WHATSAPP_ALLOWED and message the test number
ENABLE_WHATSAPP=0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# You invent this one; it just has to match what you type into the Meta console.
WHATSAPP_VERIFY_TOKEN=
# App secret from Meta > App settings > Basic. Without it every delivery is
# rejected: an unsigned webhook is an open remote-execution endpoint.
WHATSAPP_APP_SECRET=
# Comma-separated, international format, no '+'. Nobody else can make it do
# anything. Leaving this empty disables the integration rather than opening it.
WHATSAPP_ALLOWED=
WHATSAPP_SEND_RPM=40
WHATSAPP_MAX_BODY=3500

# --- Internet access ----------------------------------------------------------
# Lets the researcher role read the live web, and lets any agent read a URL that
# appears in its subtask. Keyless: DuckDuckGo's lite endpoint for search, direct
# fetch for pages. Nothing is sent outward except the query or the URL.
ENABLE_WEB=1
WEB_RESULTS=5          # search results considered
WEB_RPM=20             # be polite; a hammered endpoint starts serving captchas
WEB_CONCURRENCY=2
WEB_TIMEOUT=15
WEB_MAX_BYTES=400000   # per page, before extraction
WEB_MAX_CHARS=6000     # per page, after extraction
WEB_CACHE_TTL=900

# --- Voice ---------------------------------------------------------------------
# Speak to the octopus and hear it answer, in English or Hindi. Everything runs on
# this machine - no key, no API, nothing leaves it. Models download on first use
# into ./voices (gitignored, ~800MB all told).
ENABLE_VOICE=1

# kokoro (default) sounds human and speaks eight languages including Hindi;
# ~350MB, ~4x realtime. piper is a fifth the size and twice as fast but audibly
# synthetic and English-only in its default voice.
VOICE_ENGINE=kokoro
# 54 kokoro voices: af_/am_ US English, bf_/bm_ British, hf_/hm_ Hindi.
VOICE_KOKORO_EN=af_heart
VOICE_KOKORO_HI=hf_alpha
VOICE_SPEED=1.0
# Breathing. Kokoro's own sentence_pause argument is ignored by the published model
# export, so each sentence is synthesised separately and joined with real silence.
# These are the gap lengths in seconds.
VOICE_SENTENCE_PAUSE=0.5
VOICE_CLAUSE_PAUSE=0.22
# Only used when VOICE_ENGINE=piper. Hindi options: hi_IN-pratham-medium,
# hi_IN-priyamvada-medium, hi_IN-rohan-medium.
VOICE_PIPER_MODEL=en_US-lessac-medium

# 'small', multilingual, chosen by measurement. On the same Hindi clip 'base'
# returned Urdu script; 'small' returned correct Devanagari. On English 'base'
# heard "for agents dispatched to ran locally"; 'small' got it exactly. Roughly
# realtime here, which is fine for a voice note.
VOICE_STT_MODEL=small
# Force a language instead of letting Whisper guess. Usually unnecessary.
VOICE_STT_LANG=
# Spoken answers are capped - nobody wants two thousand words read aloud. The full
# text is always sent as well.
VOICE_MAX_CHARS=1200

# --- Chat sessions ------------------------------------------------------------
# A conversation keeps a queue and a memory until you send /new.
# Tasks are always accepted; they run one after another rather than at once,
# because two pools in one chat interleave their answers and double the load on
# the rate limits that are already the tightest constraint here.
CHAT_MAX_QUEUE=12
# Tangles that run at once in one conversation. Each task gets its own agent pool.
# Not unbounded: every agent in every tangle shares the same provider rate limits.
CHAT_MAX_CONCURRENT=3
# How many past turns a new task is told about, and how much of each.
CHAT_HISTORY_TURNS=6
CHAT_DIGEST_CHARS=500

# --- Cost control -------------------------------------------------------------
# The cheapest completion is the one never made.
#
# Below this task weight, wave 1 is planned by keyword instead of by a model. A
# one-line question does not need a planning call to establish that it is one agent,
# and on a trivial task that call is a large share of the whole run.
OCTOPUS_PLANNER_SKIP_BELOW=0.20
# Hard ceiling on estimated tokens for a single dispatch; 0 disables it. When it
# trips, no further agents are enlisted and those already running finish normally.
OCTOPUS_TOKEN_BUDGET=0
# Candidates probed per role on a cold catalog. Every probe is a real request against
# the provider's rate limit, so this is the difference between a first dispatch that
# starts in seconds and one that looks hung for a minute.
OCTOPUS_PROBE_PER_ROLE=4

# --- Future providers --------------------------------------------------------
# Registered but off, because these are paid. Gemini is free-tier and therefore
# enabled above; these exist so enabling one later is a config change, not a
# refactor.
# ENABLE_OPENAI=1
# OPENAI_API_KEY=sk-...
# ENABLE_ANTHROPIC=1          # also needs an adapter for its /messages wire format
# ANTHROPIC_API_KEY=sk-ant-...
