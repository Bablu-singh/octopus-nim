# --- Switching providers on and off -------------------------------------------
# The day a free tier stops being free, set its flag to 0. That provider leaves the
# pool, every agent silently routes to what is left, and the app keeps working
# exactly as before. No code change, no uninstall, no key to delete.
ENABLE_LOCAL=1
ENABLE_NVIDIA=1
ENABLE_GEMINI=1

# --- NVIDIA NIM (optional) ---------------------------------------------------
# Key from https://build.nvidia.com/settings/api-keys
# Leave this out entirely and the app still works — everything routes to local.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# Requests per minute. Set below the published ceiling: being throttled costs a whole
# retry, waiting a moment costs a moment.
NVIDIA_RPM=36

# --- Google Gemini (optional) -------------------------------------------------
# Key from https://aistudio.google.com/apikey — has a free tier, which is why this
# is enabled alongside NIM rather than disabled like OpenAI and Anthropic below.
# Uses Google's OpenAI-compatible surface, so no adapter is involved.
# GEMINI_API_KEY=AIza...
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Use an alias, not a dated name: Google retires those (gemini-2.0-flash
# already 404s), and an alias keeps pointing at the current model.
GEMINI_MODEL=gemini-flash-latest
# Gemini lists what it will actually serve, so its catalog is trusted rather than
# probed model by model — probing would spend free-tier requests confirming
# something already true. Set to 0 to probe it anyway.
GEMINI_TRUST_CATALOG=1
# Gemini's free tier is the tightest limit in the app, so this is the one that
# actually bites. Lower it if you see 'cooling down' in /api/providers.
GEMINI_RPM=12

# --- Local models (no key) ---------------------------------------------------
# Any OpenAI-compatible server. Ollama is the default; LM Studio serves the same
# shape on http://127.0.0.1:1234/v1.
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# Ollama lists only what is already on disk, so its catalog is trusted rather than
# probed model by model. Set to 0 to probe it anyway.
LOCAL_TRUST_CATALOG=1
# CPU inference is slow and a cold model loads from disk before the first token.
LOCAL_READ_TIMEOUT=300
LOCAL_PROBE_TIMEOUT=180
# Every token costs wall-clock time locally. This cap is what keeps small work
# genuinely faster than the round trip to NIM.
LOCAL_MAX_TOKENS=700
# 0 = ungated. Nothing is metering local requests; the only limit is the CPU, and
# OCTOPUS_LOCAL_PARALLEL already handles that.
LOCAL_RPM=0

# --- Routing -----------------------------------------------------------------
# auto  — weigh each subtask; light work goes local, heavy work to a hosted model
# Any provider name also works as a pin: local, nvidia, gemini
OCTOPUS_ROUTE=auto
# Weight above which a subtask is 'heavy'. Lower it to send more work to a hosted
# provider; which one is decided by `prefers` and `priority` in providers.py.
OCTOPUS_ROUTE_THRESHOLD=0.55
# Local inference contends for this machine's cores, so it gets its own, much
# narrower parallelism limit than hosted work.
OCTOPUS_LOCAL_PARALLEL=2
OCTOPUS_MAX_PARALLEL=6

# --- Internet access ----------------------------------------------------------
# Lets the researcher role read the live web, and lets any agent read a URL that
# appears in its subtask. Keyless: DuckDuckGo's lite endpoint for search, direct
# fetch for pages. Nothing is sent outward except the query or the URL.
ENABLE_WEB=1
WEB_RESULTS=5          # search results considered
WEB_RPM=20             # be polite; a hammered endpoint starts serving captchas
WEB_CONCURRENCY=2
WEB_TIMEOUT=15
WEB_MAX_BYTES=400000   # per page, before extraction
WEB_MAX_CHARS=6000     # per page, after extraction
WEB_CACHE_TTL=900

# --- Cost control -------------------------------------------------------------
# The cheapest completion is the one never made.
#
# Below this task weight, wave 1 is planned by keyword instead of by a model. A
# one-line question does not need a planning call to establish that it is one agent,
# and on a trivial task that call is a large share of the whole run.
OCTOPUS_PLANNER_SKIP_BELOW=0.20
# Hard ceiling on estimated tokens for a single dispatch; 0 disables it. When it
# trips, no further agents are enlisted and those already running finish normally.
OCTOPUS_TOKEN_BUDGET=0
# Candidates probed per role on a cold catalog. Every probe is a real request against
# the provider's rate limit, so this is the difference between a first dispatch that
# starts in seconds and one that looks hung for a minute.
OCTOPUS_PROBE_PER_ROLE=4

# --- Future providers --------------------------------------------------------
# Registered but off, because these are paid. Gemini is free-tier and therefore
# enabled above; these exist so enabling one later is a config change, not a
# refactor.
# ENABLE_OPENAI=1
# OPENAI_API_KEY=sk-...
# ENABLE_ANTHROPIC=1          # also needs an adapter for its /messages wire format
# ANTHROPIC_API_KEY=sk-ant-...
